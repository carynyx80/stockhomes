# ---- Network ---------------------------------------------------------------
# testnet (46630) or mainnet (4663). Pons V2 and Uniswap v4 only exist on mainnet:
# on testnet the bot only exercises its lock and database.
NETWORK=testnet
RPC_URL_TESTNET=
# Use a dedicated provider for the bot; the public endpoint rate-limits.
RPC_URL_MAINNET=

# ---- Token -----------------------------------------------------------------
# $STOXH contract address once launched on Pons V2. Empty = bot idles, Fireplace shows "not yet lit".
TOKEN_ADDRESS=

# ---- Payout wallet ---------------------------------------------------------
# The DEDICATED wallet set as creatorFeeRecipient at launch, holding nothing else.
# Server-only: set it in Vercel's encrypted env vars, never commit it, never paste it anywhere else.
CREATOR_PRIVATE_KEY=
# Optional: the same wallet's address. Lets DRY_RUN=true runs read everything with no key present at all.
PAYOUT_WALLET_ADDRESS=

# ---- Rules -----------------------------------------------------------------
CLAIM_THRESHOLD_USD=100
BURN_SHARE_BPS=2000
MAX_SLIPPAGE_BPS=200
MIN_GAS_ETH=0.002
# true = log what would happen, send nothing. Only you switch this off.
DRY_RUN=true
# Optional: first block to scan for claims (defaults to the block of the first live run).
BOT_START_BLOCK=

# ---- Infrastructure ----------------------------------------------------------
# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Postgres (Supabase, Neon / Vercel Postgres, or any other).
DATABASE_URL=
# Upstash Redis / Vercel KV, used for the run lock (the REST pair is what the bot reads).
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Alerts (optional) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- The Infinite Open House (AI agents) ----------------------------------------
# Claude API key for the agents' brains. Without it, agents run on a deterministic mock brain.
ANTHROPIC_API_KEY=
AGENT_TICK_MINUTES=5
# Ticks pause for the rest of the UTC day once model spend reaches this.
AGENT_DAILY_BUDGET_USD=20
# Optional: force the mock brain even with a key set (e.g. preview deployments).
AGENT_BRAIN=
# Salt for hashing visitor IPs (chat rate limits). Defaults to CRON_SECRET.
CHAT_SALT=
# Extra comma-separated terms for the chat filter.
MODERATION_EXTRA_TERMS=
# Phase C (agent tokens, room staking, live agent wallets). Leave false until the owner turns it on.
OPEN_HOUSE_TOKENS=false
ROOM_STAKE_STOXH=10000
# Phase C managed signer for agent wallets (one key per agent; never raw keys in env). Not used yet.
KMS_PROVIDER=
KMS_KEY_PREFIX=
