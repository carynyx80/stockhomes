# ---- Network ---------------------------------------------------------------
# testnet (46630) or mainnet (4663). Pons V2 and Uniswap v4 only exist on mainnet:
# on testnet the bot only exercises its lock and database.
NETWORK=testnet
RPC_URL_TESTNET=
# Use a dedicated provider for the bot; the public endpoint rate-limits.
RPC_URL_MAINNET=

# ---- Token -----------------------------------------------------------------
# $STOXH contract address once launched on Pons V2. Empty = bot idles, Fireplace shows "not yet lit".
TOKEN_ADDRESS=

# ---- Payout wallet ---------------------------------------------------------
# The DEDICATED wallet set as creatorFeeRecipient at launch, holding nothing else.
# Server-only: set it in Vercel's encrypted env vars, never commit it, never paste it anywhere else.
CREATOR_PRIVATE_KEY=
# Optional: the same wallet's address. Lets DRY_RUN=true runs read everything with no key present at all.
PAYOUT_WALLET_ADDRESS=

# ---- Rules -----------------------------------------------------------------
CLAIM_THRESHOLD_USD=100
BURN_SHARE_BPS=2000
MAX_SLIPPAGE_BPS=200
MIN_GAS_ETH=0.002
# true = log what would happen, send nothing. Only you switch this off.
DRY_RUN=true
# Optional: first block to scan for claims (defaults to the block of the first live run).
BOT_START_BLOCK=

# ---- Infrastructure ----------------------------------------------------------
# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Postgres (Supabase, Neon / Vercel Postgres, or any other).
DATABASE_URL=
# Upstash Redis / Vercel KV, used for the run lock (the REST pair is what the bot reads).
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Alerts (optional) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
